# Bitrix24 Webhook Configuration
# Lấy webhook URL từ Bitrix24: Settings > CRM > Webhooks > Add webhook
# Format: https://your-domain.bitrix24.com/rest/1/webhook_code/
BITRIX24_WEBHOOK_URL=https://your-domain.bitrix24.com/rest/1/your-webhook-code/

# Server Configuration
PORT=3000

# Tùy chỉnh các trường thông tin lấy ra từ Bitrix24 API
# Format: Danh sách các trường cách nhau bởi dấu phẩy (không có khoảng trắng)
# Nếu không cấu hình, sẽ sử dụng các trường mặc định

# Các trường Lead muốn lấy (tùy chọn)
# BITRIX24_LEAD_SELECT_FIELDS=ID,TITLE,NAME,LAST_NAME,STATUS_ID,STATUS_DESCRIPTION,SOURCE_ID,SOURCE_DESCRIPTION,CURRENCY_ID,OPPORTUNITY,COMPANY_TITLE,ASSIGNED_BY_ID,CREATED_BY_ID,DATE_CREATE,DATE_MODIFY,EMAIL,PHONE

# Pagination mặc định
DEFAULT_PAGE_SIZE=50

# Facebook Graph API Configuration (cho Facebook Insight Reports)
# Lấy từ Facebook Developers: https://developers.facebook.com/
# Cần tạo App và lấy Access Token với quyền ads_read, ads_management

# Facebook Graph API Base URL
# Format: https://graph.facebook.com/v24.0
# FACEBOOK_GRAPH_API=https://graph.facebook.com/v24.0

# Facebook Access Token (Long-lived token được khuyến nghị)
# Format: EAAxxxxxxxxxxxxx
# FACEBOOK_ACCESS_TOKEN=your_facebook_access_token

# Facebook Ad Account ID(s) - hỗ trợ nhiều ad accounts
# Format: act_123456789,act_987654321,act_111222333
# Có thể cấu hình một hoặc nhiều ad account IDs, cách nhau bởi dấu phẩy (không có khoảng trắng)
# FACEBOOK_AD_ACCOUNT_ID=act_your_ad_account_id
# Hoặc nhiều ad accounts:
# FACEBOOK_AD_ACCOUNT_ID=act_1245506170544668,act_1830873680857393,act_262923013482832

# Facebook App Secret Proof (bắt buộc)
# Format: HMAC-SHA256(access_token, app_secret)
# FACEBOOK_APP_SECRET_PROOF=your_app_secret_proof

# Facebook App ID (để refresh token nếu cần)
# FACEBOOK_APP_ID=your_app_id

# Facebook App Secret (để refresh token nếu cần)
# FACEBOOK_APP_SECRET=your_app_secret

# Lưu ý: Nếu không cấu hình Facebook API, hệ thống sẽ không hiển thị expenses trong reports

